# =========================================================
# Anthropic LLM configuration
# Each agent can use its own model if you want to mix tiers.
# =========================================================
ANTHROPIC_API_KEY=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
ANTHROPIC_MODEL_ORCHESTRATOR=claude-sonnet-4-5-20250929
ANTHROPIC_MODEL_ROUTER=claude-sonnet-4-5-20250929
ANTHROPIC_MODEL_JOB_CLASSIFIER=claude-sonnet-4-5-20250929
ANTHROPIC_MAX_TOKENS=1024

# =========================================================
# ServiceNow connection
# Replace SERVICENOW_USERNAME / SERVICENOW_PASSWORD with your
# real credentials (or wire this up to a secrets manager).
#
# IMPORTANT: SERVICENOW_INSTANCE_URL must be the BARE instance root only,
# e.g. https://dev198124.service-now.com
# Do NOT paste a login.do URL or any URL containing a path/query string
# (e.g. .../login.do?user_name=...&user_password=...) - that only tests
# the browser UI session login, not REST Basic Auth, and the extra path
# will break API calls. The client auto-strips a path if you do this,
# but fix it here to avoid confusion.
#
# If you get connection failures:
#  - Personal Developer Instances hibernate after inactivity. Log into
#    the instance in a browser (or use "Wake up instance" on
#    developer.servicenow.com) BEFORE running the orchestrator - REST
#    calls do not wake a sleeping instance.
#  - Run `python -m common.servicenow_client` for a standalone
#    connectivity + auth test with a clear diagnosis (DNS/TLS vs 401/403).
#  - A 401 means bad credentials; a 403 means the account is missing the
#    itil / rest_service role needed to read/write the incident table.
# =========================================================
SERVICENOW_INSTANCE_URL=https://dev198124.service-now.com
SERVICENOW_USERNAME=admin
SERVICENOW_PASSWORD=Gyli/L5i^O8Q
SERVICENOW_VERIFY_SSL=true
SERVICENOW_TIMEOUT_SECONDS=30


# =========================================================
# Qdrant vector database (shared by Incident Router Agent
# and, later, the Job Remediation Agent)
# =========================================================
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=snow_incidents

# =========================================================
# Embedding model
# =========================================================
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024
EMBEDDING_USE_FP16=true

# =========================================================
# Routing behavior
# =========================================================
CONFIDENCE_THRESHOLD=0.4
TOP_K_SIMILAR_INCIDENTS=5

# =========================================================
# Email (SMTP) - used when confidence score is too low. Sends an
# approve-link email so a human can approve the suggested L2 group with
# one click instead of manually assigning it in ServiceNow.
#
# Defaults are set up for Gmail. Gmail requires an APP PASSWORD for SMTP
# (not your normal Gmail login password) once 2-Step Verification is on:
#   1. Enable 2-Step Verification on your Google account if not already on.
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create an app password (choose "Mail" / "Other") and paste the
#      16-character password below as SMTP_PASSWORD.
# =========================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
SMTP_USERNAME=raoniranjan007@gmail.com
SMTP_PASSWORD=juvs wbcb rnmk ghwj
SMTP_FROM=raoniranjan007@gmail.com
SMTP_TO_HUMAN_REVIEW=raoniranjan007@gmail.com

# =========================================================
# Approval server - handles the "Approve" link click from the email.
# Run `python approval_server.py` alongside main.py.
#
# APPROVAL_BASE_URL must be reachable from wherever you'll click the
# email link:
#  - Testing on your own machine: http://localhost:8000 is fine.
#  - Clicking from your phone/another machine: use your machine's LAN
#    IP (e.g. http://192.168.1.20:8000) or a tunnel (ngrok, ssh -R, a
#    reverse proxy) and put that public URL here instead.
# =========================================================
APPROVAL_BASE_URL=http://localhost:8000
APPROVAL_SERVER_HOST=0.0.0.0
APPROVAL_SERVER_PORT=8000
APPROVAL_DB_PATH=approvals.db
APPROVAL_TOKEN_TTL_HOURS=72

# =========================================================
# Job Remediation AI Agent - guardrails that gate auto-execution.
# ALL of these must pass or the action goes to a human approve/reject
# email instead of running automatically. See common/guardrails.py.
# ANTHROPIC_MODEL_JOB_CLASSIFIER (above) is reused as this agent's model.
# =========================================================
REMEDIATION_CONFIDENCE_THRESHOLD=0.4
REMEDIATION_ALLOWED_RISK_LEVELS=LOW,MEDIUM
REMEDIATION_BLOCKED_ACTIONS=
SOP_DOCUMENTS_DIR=sop_documents
AUDIT_DB_PATH=audit_trail.db

# =========================================================
# AWS connection - the Job Remediation AI Agent's executor
# (common/remediation_executor.py) makes REAL boto3 calls against your
# AWS account (restart ECS services, reboot RDS/EC2, retry Step
# Functions/Glue jobs, etc.) once a remediation action is approved.
#
# No custom credential system here - boto3's standard credential chain
# is used, same as the AWS CLI:
#   1. AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY env vars (below), OR
#   2. a named profile via AWS_PROFILE (from `aws configure --profile X`), OR
#   3. an IAM role (EC2 instance profile / ECS task role) if this runs on AWS.
# Prefer option 2 or 3 over long-lived access keys where possible.
#
# See the README's "AWS Prerequisites" section for the exact IAM policy
# needed and which AWS resources must already exist before this agent
# can remediate them.
# =========================================================
AWS_REGION=us-east-1
#AWS_PROFILE=
# Only set these if NOT using a profile or IAM role:
AWS_ACCESS_KEY_ID=AKIA2UC3AW3FYNGV3CXE
AWS_SECRET_ACCESS_KEY=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

# =========================================================
# CloudWatch Logs - the Job Remediation AI Agent's SECOND grounding
# source alongside SOPs (common/cloudwatch_client.py). Requires
# logs:DescribeLogGroups and logs:FilterLogEvents - see the README.
# Decision rule: proceeds if a SOP matched OR logs were found (or both);
# only sends to human intervention if NEITHER is available.
# =========================================================
CLOUDWATCH_ENABLED=true
CLOUDWATCH_LOOKBACK_MINUTES=60
CLOUDWATCH_MAX_LOG_EVENTS=50
CLOUDWATCH_FILTER_PATTERN=?ERROR ?Exception ?FAILED ?Failed

# =========================================================
# Orchestrator polling
# =========================================================
POLL_INTERVAL_SECONDS=10
INCIDENT_QUERY_FILTER=active=true^assignment_group=^ORassignment_groupISEMPTY
